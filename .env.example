# ============================================================================
# .env namunasi — `cp .env.example .env` qilib, qiymatlarni to'ldiring.
# .env fayli gitga KIRMAYDI (.gitignore'da) — parollar faqat serverda yashaydi.
# Ishlatilishi: docker compose -f docker-compose.prod.yml up -d
# ============================================================================

# --- PostgreSQL (yangi, prod) ---
# DB nomi va user: default 'thingsboard' / 'postgres'. O'zgartirsangiz, migratsiya
# davridagi bazaga mos kelishini tekshiring (bazada user allaqachon yaratilgan —
# odatda default qoldiriladi).
NEW_PG_DB=thingsboard
NEW_PG_USER=postgres
# MAJBURIY: kuchli parol. Prod compose'da default yo'q (xato beradi agar .env'da yo'q).
NEW_PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- ThingsBoard PE license ---
# MAJBURIY: thingsboard.io license portalidan olingan secret.
TB_LICENSE_SECRET=CHANGE_ME_LICENSE_SECRET
# Instance data fayli (container ichidagi yo'l). ./tb-pe/license/ host papkasiga
# mount qilingan (/data). Default odatda o'zgarmaydi.
TB_LICENSE_INSTANCE_DATA_FILE=/data/license.data
